# --- Database (required) ---
DB_NAME=asiandoor
DB_URL=jdbc:postgresql://localhost:5432/asiandoor
DB_USER=asiandoor_user
DB_PASSWORD=asiandoor

# --- Seeded admin account (required for first login) ---
APP_ADMIN_NAME=Asian Wooden Decor Admin
APP_ADMIN_EMAIL=admin@asiandoor.com
APP_ADMIN_PASSWORD=change_this_admin_password

# --- Signup verification (email OTP) ---
APP_VERIFICATION_CODE_EXPIRY_MINUTES=10
APP_PASSWORD_RESET_CODE_EXPIRY_MINUTES=10

# --- Mail settings (required for OTP email) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tno-reply@asiandoor.local
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- Optional runtime overrides ---
SERVER_PORT=8081
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
UPLOAD_PRODUCTS_DIR=uploads/products
