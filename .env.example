# --- Database (required) ---
DB_NAME=asiandoor
DB_URL=jdbc:postgresql://localhost:5432/asiandoor
DB_USER=asiandoor_user
DB_PASSWORD=asiandoor

# --- Seeded admin account (required for first login) ---
APP_ADMIN_NAME=Asian Door Admin
APP_ADMIN_EMAIL=admin@asiandoor.com
APP_ADMIN_PASSWORD=change_this_admin_password

# --- Optional runtime overrides ---
SERVER_PORT=8081
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true
UPLOAD_PRODUCTS_DIR=uploads/products
